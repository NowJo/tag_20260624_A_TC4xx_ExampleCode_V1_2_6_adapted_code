/* Watchdog Timer Unit, Control Register B */
typedef volatile union
{
  struct
  {
    unsigned int DR       : 1;  /* Disable request Bit */
    unsigned int reserved : 3;  /* read as 0 */
    unsigned int IFSR     : 2;  /* Input frequency selection request bit */
    unsigned int URR      : 1;  /* Unlock restriction request bit */
    unsigned int PAR      : 1;  /* Password auto-sequence request bit */
    unsigned int TCR      : 1;  /* Timer check request bit */
    unsigned int TCTR     : 7;  /* Timer check tolerance request */
    unsigned int TIMR     : 16; /* Timer base request value */
  } B;
  int I;
  unsigned int U;
} WDT_CTRL_B_type;
