/* SCU_OVCENABLE */
typedef volatile union
{
  struct
  {
    unsigned int OVEN0 : 1; /* Overlay Enable 0 */
    unsigned int OVEN1 : 1; /* Overlay Enable 1 (If product has CPU1) */
    unsigned int OVEN2 : 1; /* Overlay Enable 2 (If product has CPU2) */
    unsigned int OVEN3 : 1; /* Overlay Enable 3 (If product has CPU3) */
    unsigned int OVEN4 : 1; /* Overlay Enable 4 (If product has CPU4) */
    unsigned int OVEN5 : 1; /* Overlay Enable 5 (If product has CPU5) */
    unsigned int       : 2; /* reserved */
    unsigned int GOD   : 1; /** NEW < \brief [8:8] Global Overlay Disable (rw1s) */
    unsigned int       : 23;
  } B;
  int I;
  unsigned int U;
} SCU_OVCENABLE_type;
#define SCU_OVCENABLE (*(SCU_OVCENABLE_type*)(SCU_BASE + 0x01A0)) /* Overlay Enable Register */

/* SCU_OVCCON */
typedef volatile union
{
  struct
  {
    unsigned int CSEL0   : 1; /* CPU Select 0 */
    unsigned int CSEL1   : 1; /* CPU Select 1 (If product has CPU1) */
    unsigned int CSEL2   : 1; /* CPU Select 2 (If product has CPU2) */
    unsigned int CSEL3   : 1; /* CPU Select 3 (If product has CPU3) */
    unsigned int CSEL4   : 1; /* CPU Select 4 (If product has CPU4) */
    unsigned int CSEL5   : 1; /* CPU Select 3 (If product has CPU3) */
    unsigned int         : 10;
    unsigned int OVSTRT  : 1; /* Overlay Start */
    unsigned int OVSTP   : 1; /* Overlay Stop */
    unsigned int DCINVAL : 1; /* Data Cache Invalidate */
    unsigned int         : 5;
    unsigned int OVCONF  : 1; /* Overlay Configured */
    unsigned int POVCONF : 1; /* Write Protection for OVCONF */
    unsigned int         : 6;
  } B;
  int I;
  unsigned int U;
} SCU_OVCCON_type;
#define SCU_OVCCON (*(SCU_OVCCON_type*)(SCU_BASE + 0x01A4)) /* Overlay Control Register */

