#define WDT_SYS_CTRL_B   (*(WDT_CTRL_B_type*)(WDT_BASE + 0x1AC)) /* System Watchdog Control Register B */

/* Watchdog Timer Unit, Status Register */
typedef volatile union
{
  struct
  {
    unsigned int D   : 1;  /* Watchdog enable/disable status flag */
    unsigned int TOM : 1;  /* Watchdog timeout mode flag */
    unsigned int OE  : 1;  /* Watchdog overflow error status flag */
    unsigned int AE  : 1;  /* Watchdog access error status flag */
    unsigned int IFS : 2;  /* Watchdog internal frequency selection status flag */
    unsigned int UR  : 1;  /* SMU unlock restriction flag */
    unsigned int PA  : 1;  /* Password auto-sequence status flag */
    unsigned int TC  : 1;  /* Timer check status flag */
    unsigned int TCT : 7;  /* Timer check tolerance */
    unsigned int TIM : 16; /* Timer value */
  } B;
  int I;
  unsigned int U;
} WDT_STAT_type;
