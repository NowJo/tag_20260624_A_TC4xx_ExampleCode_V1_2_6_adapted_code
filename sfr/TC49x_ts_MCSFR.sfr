#ifndef TC49X_SFR_FILE
#define TC49X_SFR_FILE

// todo srg TC4xx, check definitions
#define PMA0  0x8100 /* Physical Memory Attributes */
#define DCON0 0x9040 /* Data Memory Control Register */
#define PCON0 0x920c /* Program Control 0 */
#define PCON1 0x9204 /* Program Control 1 */
#define PSW   0xFE04 /* Specific Program Status Word */
#define PCXI  0xFE00 /* Specific Previous Context information Register */
#define BTV   0xFE24 /* Specific Base Trap Vector Table Pointer */
#define BIV   0xFE20 /* Specific Base Interrupt Vector Table Pointer */
#define ISP   0xFE28 /* Specific Interrupt Stack Pointer */
#define LCX   0xFE3C /* Specific Free CSA List Limit Pointer */
#define FCX   0xFE38 /* Specific Free CSA List Head Pointer */


/* from Aurix TC49x user manual V0.73, TC18, physical addresses of any CPU CSFR or SFR or FSFR and ff */
#define WDT_BASE     0xF0000000
#define SCU_BASE     0xF0024000
#define SMM_BASE     0xF0060000
#define FSFR_BASE    0xF8400000
#define SFR_BASE     0xF8800000
#define OVERLAY_BASE 0x0000FB00
#define UCB0_BASE    0xAE400000
#define ASCLIN0_BASE 0xF02C0000
#define CCU_BASE     0xF0064000
#define CBS_BASE     0xFA180000
#define SRC_BASE     0xF0032000

#define CORE(n)        ((uint32)(n) << 18)
#define OSEL           0x0
#define RABR(i)        ((uint32)0x10 + (i)*12)
#define OTAR(i)        ((uint32)0x14 + (i)*12)
#define OMASK(i)       ((uint32)0x18 + (i)*12)
#define PyFLASHCON0(y) ((uint32)0x200 + (y)*8)
#define PyFLASHCON1(y) ((uint32)0x208 + (y)*8)
#define STM_CPU0_SR(n) ((uint32)0x20 + (n)*4)
#define STM_CPU1_SR(n) ((uint32)0x20 + 0x40 + (n)*4)
#define STM_CPU2_SR(n) ((uint32)0x20 + (2 * 0x40) + (n)*4)
#define STM_CPU3_SR(n) ((uint32)0x20 + (3 * 0x40) + (n)*4)
#define STM_CPU4_SR(n) ((uint32)0x20 + (4 * 0x40) + (n)*4)
#define STM_CPU5_SR(n) ((uint32)0x20 + (5 * 0x40) + (n)*4)

#define P00_BASE                    0xF003A000
#define P10_BASE                    0xF003C800
#define P13_BASE                    0xF003D400
#define P14_BASE                    0xF003D800
#define P21_BASE                    0xF003F400
#define P23_BASE                    0xF003FC00
#define P30_BASE                    0xF0041800
#define P32_BASE                    0xF0042000
#define P33_BASE                    0xF0042400
#define PxxPADCFGp_DRVCFG_OFFSET(p) ((uint32)0x304 + (0x10 * (p)))


/* CBS_OSTATE */
typedef volatile union
{
  struct
  {
    unsigned int OEN    : 1; /* OCDS Enabled Flag */
    unsigned int OC0    : 1; /* OCDS Control Bits System Bus Domain */
    unsigned int OC1    : 1; /* OCDS Control Bits System Bus Domain */
    unsigned int OC2    : 1; /* OCDS Control Bits System Bus Domain */
    unsigned int ENIDIS : 1; /* OCDS ENDINIT Protection Override */
    unsigned int EECTRC : 1; /* On Chip Trace Enable */
    unsigned int EECDIS : 1; /* Emulation Logic Disable */
    unsigned int WDTSUS : 1; /* Control of Watchdog Timer (WDT) Suspension */
    unsigned int HARR   : 1; /* Halt after Reset Request */
    unsigned int OJC1   : 1; /* OCDS Control Bits IOClient Domain */
    unsigned int OJC2   : 1; /* OCDS Control Bits IOClient Domain */
    unsigned int OJC3   : 1; /* OCDS Control Bits IOClient Domain */
    unsigned int RSTCL0 : 1; /* OCDS System Reset Request */
    unsigned int RSTCL1 : 1; /* OCDS Debug Reset Request */
    unsigned int OJC6   : 1; /* OCDS Control Bits IOClient Domain */
    unsigned int RSTCL3 : 1; /* OCDS Application Reset Request */
    unsigned int IF_LCK : 1; /* Interface Locked Indication */
    unsigned int AUT_OK : 1; /* Authorization OK Indication */
    unsigned int STABLE : 1; /* Application ResetIndication */
    unsigned int OCO    : 1; /* OCDS debug resource Clock On indication */
    unsigned int        : 12;
  } B;
  int I;
  unsigned int U;
} CBS_OSTATE_type;
#define CBS_OSTATE (*(CBS_OSTATE_type*)(CBS_BASE + 0x06C)) /* OSCUStatus Register */

/* CBS_OEC */
typedef volatile union
{
  struct
  {
    unsigned int PAT      : 8; /* OCDS Enabling Pattern */
    unsigned int DS       : 1; /* Disable OCDS */
    unsigned int OCO      : 1; /* OCDS Clock Off */
    unsigned int          : 6;
    unsigned int IF_LCK_P : 1; /* IF_LCK Write Protection */
    unsigned int IF_LCK   : 1; /* Set/Clear Interface Locked Indication */
    unsigned int AUT_OK_P : 1; /* AUT_OK Write Protection */
    unsigned int AUT_OK   : 1; /* Set/Clear the Authorization OK Indication */
    unsigned int          : 12;
  } B;
  int I;
  unsigned int U;
} CBS_OEC_type;
#define CBS_OEC (*(CBS_OEC_type*)(CBS_BASE + 0x068)) /* OCDS Enable Control Register */

/* CBS_OCNTRL */
typedef volatile union
{
  struct
  {
    unsigned int OC0_P    : 1; /* OC0 Write Protection */
    unsigned int OC0      : 1; /* Set/Clear OCDS Control Bits Bus Domain */
    unsigned int OC1_P    : 1; /* OC1 Write Protection */
    unsigned int OC1      : 1; /* Set/Clear OCDS Control Bits Bus Domain */
    unsigned int OC2_P    : 1; /* OC2 Write Protection */
    unsigned int OC2      : 1; /* Set/Clear OCDS Control Bits Bus Domain */
    unsigned int OC3_P    : 1; /* OC3 Write Protection */
    unsigned int OC3      : 1; /* Set/Clear OCDS Control Bits Bus Domain */
    unsigned int OC4_P    : 1; /* OC4 Write Protection */
    unsigned int OC4      : 1; /* Set/Clear OCDS Control Bits Bus Domain */
    unsigned int OC5_P    : 1; /* OC5 Write Protection */
    unsigned int OC5      : 1; /* Set/Clear OCDS Control Bits Bus Domain */
    unsigned int WDTSUS_P : 1; /* WDTSUS Write Protection */
    unsigned int WDTSUS   : 1; /* Set/Clear Watchdog Timer Suspension Control */
    unsigned int STABLE_P : 1; /* STABLE Write Protection */
    unsigned int STABLE   : 1; /* InitializeApplication ResetIndication */
    unsigned int OJC0_P   : 1; /* OJC0 Write Protection */
    unsigned int OJC0     : 1; /* Set/Clear OCDS Control Bits IOClient Domain */
    unsigned int OJC1_P   : 1; /* OJC1 Write Protection */
    unsigned int OJC1     : 1; /* Set/Clear OCDS Control Bits IOClient Domain */
    unsigned int OJC2_P   : 1; /* OJC2 Write Protection */
    unsigned int OJC2     : 1; /* Set/Clear OCDS Control Bits IOClient Domain */
    unsigned int OJC3_P   : 1; /* OJC3 Write Protection */
    unsigned int OJC3     : 1; /* Set/Clear OCDS Control Bits IOClient Domain */
    unsigned int OJC4_P   : 1; /* OJC4 Write Protection */
    unsigned int OJC4     : 1; /* Set/Clear OCDS Control Bits IOClient Domain */
    unsigned int OJC5_P   : 1; /* OJC5 Write Protection */
    unsigned int OJC5     : 1; /* Set/Clear OCDS Control Bits IOClient Domain */
    unsigned int OJC6_P   : 1; /* OJC6 Write Protection */
    unsigned int OJC6     : 1; /* Set/Clear OCDS Control Bits IOClient Domain */
    unsigned int OJC7_P   : 1; /* OJC7 Write Protection */
    unsigned int OJC7     : 1; /* Set/Clear OCDS Control Bits IOClient Domain */
  } B;
  int I;
  unsigned int U;
} CBS_OCNTRL_type;
#define CBS_OCNTRL (*(CBS_OCNTRL_type*)(CBS_BASE + 0x064)) /* OSCUControl Register */

/* CBS_IOSR */
typedef volatile union
{
  struct
  {
    unsigned int          : 4;
    unsigned int CRSYNC   : 1; /* Communication Mode Read Sync Flag */
    unsigned int CWSYNC   : 1; /* Communication Mode Write Sync Flag */
    unsigned int CW_ACK   : 1; /* Communication Mode Write Acknowledge */
    unsigned int COM_SYNC : 1; /* Communication Mode Synchronization Flag */
    unsigned int HOSTED   : 1; /* Tool Interface in Use */
    unsigned int          : 3;
    unsigned int CHANNEL  : 3; /* Channel Indication */
    unsigned int          : 17;
  } B;
  int I;
  unsigned int U;
} CBS_IOSR_type;
#define CBS_IOSR (*(CBS_IOSR_type*)(CBS_BASE + 0x088)) /* IOClientStatus and Control Register */

/* CBS_COMDATA */
typedef volatile union
{
  struct
  {
    unsigned int DATA : 32; /* Read/Write Data */
  } B;
  int I;
  unsigned int U;
} CBS_COMDATA_type;
#define CBS_COMDATA (*(CBS_COMDATA_type*)(CBS_BASE + 0x084)) /* Communication Mode Data Register */

/* CPUx PFlash Interface 0,1 Configuration Register 0 */
typedef volatile union
{
  struct
  {
    unsigned int TAG1              : 6; /* Flash Prefetch Buffer 1 Configuration */
    /* const */ unsigned int RES_0 : 2; /* Reserved */
    unsigned int TAG2              : 6; /* Flash Prefetch Buffer 2 Configuration */
    /* const */ unsigned int RES_1 : 2; /* Reserved */
    unsigned int TAG3              : 6; /* Flash Prefetch Buffer 3 Configuration */
    /* const */ unsigned int RES_2 : 2; /* Reserved */
    unsigned int TAG4              : 6; /* Flash Prefetch Buffer 4 Configuration */
    /* const */ unsigned int RES_3 : 2; /* Reserved */
  } B;
  int I;
  unsigned int U;
} CPU_FLASHCON0_type;

/* CPUx PFlash Interface 0,1 Configuration Register 1 */
typedef volatile union
{
  struct
  {
    unsigned int STALL             : 1;  /* Stall Bus Request */
    /* const */ unsigned int RES_0 : 31; /* Reserved */
  } B;
  int I;
  unsigned int U;
} CPU_FLASHCON1_type;

/* CPU0_OSEL */
typedef volatile union
{
  struct
  {
    unsigned int SHOVEN0  : 1; /* Shadow Overlay Enable x */
    unsigned int SHOVEN1  : 1; /* Shadow Overlay Enable x */
    unsigned int SHOVEN2  : 1; /* Shadow Overlay Enable x */
    unsigned int SHOVEN3  : 1; /* Shadow Overlay Enable x */
    unsigned int SHOVEN4  : 1; /* Shadow Overlay Enable x */
    unsigned int SHOVEN5  : 1; /* Shadow Overlay Enable x */
    unsigned int SHOVEN6  : 1; /* Shadow Overlay Enable x */
    unsigned int SHOVEN7  : 1; /* Shadow Overlay Enable x */
    unsigned int SHOVEN8  : 1; /* Shadow Overlay Enable x */
    unsigned int SHOVEN9  : 1; /* Shadow Overlay Enable x */
    unsigned int SHOVEN10 : 1; /* Shadow Overlay Enable x */
    unsigned int SHOVEN11 : 1; /* Shadow Overlay Enable x */
    unsigned int SHOVEN12 : 1; /* Shadow Overlay Enable x */
    unsigned int SHOVEN13 : 1; /* Shadow Overlay Enable x */
    unsigned int SHOVEN14 : 1; /* Shadow Overlay Enable x */
    unsigned int SHOVEN15 : 1; /* Shadow Overlay Enable x */
    unsigned int SHOVEN16 : 1; /* Shadow Overlay Enable x */
    unsigned int SHOVEN17 : 1; /* Shadow Overlay Enable x */
    unsigned int SHOVEN18 : 1; /* Shadow Overlay Enable x */
    unsigned int SHOVEN19 : 1; /* Shadow Overlay Enable x */
    unsigned int SHOVEN20 : 1; /* Shadow Overlay Enable x */
    unsigned int SHOVEN21 : 1; /* Shadow Overlay Enable x */
    unsigned int SHOVEN22 : 1; /* Shadow Overlay Enable x */
    unsigned int SHOVEN23 : 1; /* Shadow Overlay Enable x */
    unsigned int SHOVEN24 : 1; /* Shadow Overlay Enable x */
    unsigned int SHOVEN25 : 1; /* Shadow Overlay Enable x */
    unsigned int SHOVEN26 : 1; /* Shadow Overlay Enable x */
    unsigned int SHOVEN27 : 1; /* Shadow Overlay Enable x */
    unsigned int SHOVEN28 : 1; /* Shadow Overlay Enable x */
    unsigned int SHOVEN29 : 1; /* Shadow Overlay Enable x */
    unsigned int SHOVEN30 : 1; /* Shadow Overlay Enable x */
    unsigned int SHOVEN31 : 1; /* Shadow Overlay Enable x */
  } B;
  int I;
  unsigned int U;
} CPU_OSEL_type;

/* CPU_RABR0_1 */
typedef volatile union
{
  struct
  {
    /* const */ unsigned int RES_0 : 4;  /* Reserved */
    unsigned int OBASE             : 19; /* Overlay Block Base Address */
    unsigned int OMEM              : 4;  /* Overlay Memory Select */
    /* const */ unsigned int RES_2 : 3;  /* Reserved */
    unsigned int OVEN              : 1;  /* Overlay Enabled */
  } B;
  int I;
  unsigned int U;
} CPU_RABR0_1_type;

/* CPU_RABR */
typedef volatile union
{
  struct
  {
    /* const */ unsigned int RES_0 : 5;  /* Reserved */
    unsigned int OBASE             : 17; /* Overlay Block Base Address */
    /* const */ unsigned int RES_1 : 2;  /* Reserved */
    unsigned int OMEM              : 4;  /* Overlay Memory Select */
    /* const */ unsigned int RES_2 : 3;  /* Reserved */
    unsigned int OVEN              : 1;  /* Overlay Enabled */
  } B;
  int I;
  unsigned int U;
} CPU_RABR_type;

/* CPU_OTAR */
typedef volatile union
{
  struct
  {
    /* const */ unsigned int RES_0 : 5;  /* Reserved */
    unsigned int TBASE             : 23; /* Target Base */
    /* const */ unsigned int RES_1 : 4;  /* Reserved */
  } B;
  int I;
  unsigned int U;
} CPU_OTAR_type;

/* CPU_OMASK0_1 */
typedef volatile union
{
  struct
  {
    /* const */ unsigned int RES_0 : 5;  /* Reserved */
    unsigned int OMASK             : 17; /* Overlay Address Mask */
    /* const */ unsigned int ONE   : 6;  /* Fixed “1” Values */
    /* const */ unsigned int RES_1 : 4;  /* Reserved */
  } B;
  int I;
  unsigned int U;
} CPU_OMASK0_1_type;

/* CPU_OMASK */
typedef volatile union
{
  struct
  {
    /* const */ unsigned int RES_0 : 5;  /* Reserved */
    unsigned int OMASK             : 12; /* Overlay Address Mask */
    /* const */ unsigned int ONE   : 11; /* Fixed “1” Values */
    /* const */ unsigned int RES_1 : 4;  /* Reserved */
  } B;
  int I;
  unsigned int U;
} CPU_OMASK_type;

